
# ── Base de datos PostgreSQL ─────────────────────────────────────────────────
POSTGRES_DB=congenia
POSTGRES_USER=congenia
POSTGRES_PASSWORD=
# Rol de la aplicacion (api y pdf_worker). Solo puede insertar y leer la
# bitacora de auditoria; las migraciones usan POSTGRES_USER.
POSTGRES_APP_USER=congenia_app
POSTGRES_APP_PASSWORD=
# REQUERIDO: Establecer contraseña segura
POSTGRES_PORT=5432

# ── API Backend ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development
API_PORT=3000

# 64 caracteres hexadecimales (32 bytes) para cifrar payloads temporales de integracion
APP_ENCRYPTION_KEY=
SESSION_EXPIRY_MINUTES=60

# Orígenes permitidos para CORS (separados por coma)
# En desarrollo local, incluir el puerto del frontend
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# OAuth 2.0 / Keycloak para integracion servidor-a-servidor
KEYCLOAK_VERSION=26.6.1
KEYCLOAK_PORT=8082
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_SADC_CLIENT_SECRET=
KEYCLOAK_MEDICO_INITIAL_PASSWORD=
OIDC_ISSUER_URL=http://keycloak:8082/realms/congenia
# Lista opcional de issuers válidos (separados por coma). Útil en dev cuando
# algunos tokens salen con host interno `keycloak:8080` y otros con `localhost:8082`.
OIDC_ISSUER_URLS=http://localhost:8082/realms/congenia,http://keycloak:8080/realms/congenia
OIDC_JWKS_URL=http://keycloak:8080/realms/congenia/protocol/openid-connect/certs
OIDC_AUDIENCE=congenia-api
OIDC_WEB_CLIENT_ID=congenia-web

# Redis para cache temporal de sesiones de integracion
REDIS_VERSION=7.2-alpine
REDIS_PASSWORD=
REDIS_PORT=6379

# ── RabbitMQ ────────────────────────────────────────────────────────────────
# Broker de mensajería AMQP para eventos asíncronos
RABBITMQ_DEFAULT_USER=congenia
# REQUERIDO: Usuario administrador de RabbitMQ
RABBITMQ_DEFAULT_PASS=
# REQUERIDO: Contraseña administrador de RabbitMQ
RABBITMQ_DEFAULT_VHOST=/
# VHost por defecto
RABBITMQ_AMQP_PORT=5672
# Puerto AMQP (clientes)
RABBITMQ_MANAGEMENT_PORT=15672
# Puerto de consola web (Management UI)

# ── PDF Worker / Cola de Consentimientos ────────────────────────────────────
RABBITMQ_QUEUE_MAIN=consent.pdf.generate
RABBITMQ_QUEUE_DLQ=consent.pdf.generate.dlq
WORKER_PREFETCH=3
WORKER_MAX_RETRIES=5
WORKER_RETRY_BACKOFF_MS=2000
WORKER_RETRY_BACKOFF_MULTIPLIER=2

S3_ENDPOINT=http://seaweedfs:8333
# Endpoint publico para URLs presignadas consumidas por navegador (dev local)
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_BUCKET=congenia-docs
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=congenia
S3_SECRET_ACCESS_KEY=
S3_UPLOAD_MAX_BYTES=10485760

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=8080
API_BASE_URL=http://localhost:3000
VITE_APP_ENV=development
FRONTEND_BASE_URL=http://localhost:8080
FRONTEND_FICHA_ROUTE=/
USE_FICHA_SEARCH_MOCK=false
USE_ADENDAS_MOCK=false
USE_CIE10_MOCK=false

# ── CIE-10 Batch ─────────────────────────────────────────────────────────────
# Se ejecuta manualmente con:
# docker compose --profile jobs run --rm cie10_batch
OPENAI_API_KEY=
CIE10_SOURCE_MODE=local
CIE10_CATALOG_CSV_PATH=/data/CIE10.csv
CIE10_TRANSLATOR_CSV_PATH=/data/CIE10_Traductor.csv
CIE10_MAX_RECORDS=10
CIE10_OPENAI_MODEL=gpt-6-luna
CIE10_REASONING_EFFORT=medium
CIE10_REPAIR_ATTEMPTS=2

# Reporting/Text-to-SQL agent. The reporting database is external and loaded
# with CONGENIA-REPORTING-PIPELINE; these values are server-side only.
REPORTING_DATABASE_APP_URL=
REPORTING_DATABASE_AGENT_READONLY_URL=
REPORTING_STATEMENT_TIMEOUT_MS=5000
REPORTING_MCP_TOKEN=
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=low
REPORTING_CONVERSATION_TTL_SECONDS=1800
REPORTING_CONVERSATION_MAX_TURNS=8
AGENT_PROMPT_VERSION=agent-reporting-v1
DATASET_VERSION=unset
REPORTING_SCHEMA_VERSION=reporting-v1

# ── Playground Dev (Vite) ─────────────────────────────────────────────
# Se levanta con: docker compose --profile dev up -d playground
PLAYGROUND_PORT=5173
PLAYGROUND_VITE_API_URL=http://localhost:3000/v1
PLAYGROUND_VITE_API_INTEGRATION_URL=http://localhost:3000/api/v1
PLAYGROUND_KEYCLOAK_PROXY_TARGET=http://keycloak:8080
PLAYGROUND_KEYCLOAK_TOKEN_URL=/keycloak/realms/congenia/protocol/openid-connect/token
PLAYGROUND_KEYCLOAK_CLIENT_ID=sadc
PLAYGROUND_KEYCLOAK_CLIENT_SECRET=
PLAYGROUND_KEYCLOAK_SCOPE=congenia.sessions:init
PLAYGROUND_VITE_OFFICIAL_FORM_URL=http://localhost:8080/
PLAYGROUND_VITE_FICHA_URL=http://localhost:5173/ficha
PLAYGROUND_PATIENT_ID=
PLAYGROUND_PATIENT_NOMBRE=
PLAYGROUND_FECHA_CONSULTA=
PLAYGROUND_DIAGNOSTICO=
PLAYGROUND_MEDICO_ID=
PLAYGROUND_MEDICO_NOMBRE=
PLAYGROUND_ESPECIALIDAD=

# ── OAuth 2.0 / OIDC ─────────────────────────────────────────────────────────
# Configuración del proveedor de identidad (Keycloak, Auth0, etc.)
VITE_OIDC_AUTHORITY=http://localhost:8082/realms/congenia
VITE_OIDC_CLIENT_ID=congenia-web

# ── FHIR Server ──────────────────────────────────────────────────────────────
VITE_FHIR_BASE_URL=https://fhir.ejemplo.com/r4

# ── API URL para Frontend ────────────────────────────────────────────────────
# En desarrollo local, apunta al puerto de la API
VITE_API_BASE_URL=http://localhost:3000

# ── SeaweedFS ────────────────────────────────────────────────────────────────
# Sistema de almacenamiento de archivos distribuido
SEAWEED_VERSION=latest
SEAWEED_MASTER_PORT=9333
SEAWEED_VOLUME_PORT=8081
# Nota: puerto 8081 en host para evitar conflicto con frontend
SEAWEED_S3_PORT=8333
SEAWEED_FILER_PORT=8888
SEAWEED_MAX_VOLUMES=50
# Desarrollo recomendado: >= 20 (para evitar "No writable volumes"), Producción: 50+
SEAWEED_VOLUME_SIZE_LIMIT=30000
# MB por volumen (30GB)

# ── CIE-10 Batch / Export CSV ───────────────────────────────────────────────
CIE10_REVIEW_EXPORT_S3_PREFIX=s3://congenia-docs/cie10-exports/

# ── Versiones de Imágenes (Docker Hub) ──────────────────────────────────────
# Docker Hub: xavierlopez25/congenia:api-{VERSION}
#             xavierlopez25/congenia:frontend-{VERSION}
API_VERSION=1.0.0
# Versión de imagen de API a deployar
FRONTEND_VERSION=1.0.0
# Versión de imagen de Frontend a deployar
PDF_WORKER_VERSION=1.0.0
# Versión de imagen de PDF worker a deployar

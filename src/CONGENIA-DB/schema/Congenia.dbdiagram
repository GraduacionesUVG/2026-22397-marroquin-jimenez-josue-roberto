Ref fk_ficha_raiz: ficha_clinica.ficha_raiz_id > ficha_clinica.ficha_id
Ref fk_ficha_resuelta_por: ficha_clinica.resuelta_por > usuario.usuario_id
Ref datos_adicionales_ficha_asistencia_parto_id_fkey: datos_adicionales_ficha.asistencia_parto_id > asistencia_parto.asistencia_parto_id
Ref datos_adicionales_ficha_ficha_id_fkey: datos_adicionales_ficha.ficha_id - ficha_clinica.ficha_id
Ref datos_adicionales_ficha_referido_de_id_fkey: datos_adicionales_ficha.referido_de_id > referido_de.referido_de_id
Ref fk_datos_adicionales_sexo: datos_adicionales_ficha.sexo_id > sexo_catalogo.sexo_id
Ref familiar_afectado_familiar_catalogo_id_fkey: familiar_afectado.familiar_catalogo_id > familiar_catalogo.familiar_catalogo_id
Ref familiar_afectado_ficha_id_fkey: familiar_afectado.ficha_id > ficha_clinica.ficha_id
Ref fk_signo_replaces: signo_alerta_ficha.replaces_signo_id > signo_alerta_ficha.signo_id
Ref signo_alerta_ficha_ficha_id_fkey: signo_alerta_ficha.ficha_id > ficha_clinica.ficha_id
Ref signo_alerta_ficha_parte_id_fkey: signo_alerta_ficha.parte_id > parte_del_cuerpo.parte_id
Ref signo_alerta_ficha_registrado_por_fkey: signo_alerta_ficha.registrado_por > usuario.usuario_id
Ref examen_ficha_ficha_id_fkey: examen_ficha.ficha_id > ficha_clinica.ficha_id
Ref examen_ficha_registrado_por_fkey: examen_ficha.registrado_por > usuario.usuario_id
Ref fk_examen_replaces: examen_ficha.replaces_examen_id > examen_ficha.examen_ficha_id
Ref fk_observacion_ficha: observacion_ficha.ficha_id > ficha_clinica.ficha_id
Ref fk_observacion_usuario: observacion_ficha.usuario_id > usuario.usuario_id
Ref resultado_ia_ejecutado_por_fkey: resultado_ia.ejecutado_por > usuario.usuario_id
Ref resultado_ia_ficha_id_fkey: resultado_ia.ficha_id > ficha_clinica.ficha_id
Ref ficha_provisional_creado_por_fkey: ficha_provisional.creado_por > usuario.usuario_id
Ref ficha_provisional_ficha_consolidada_id_fkey: ficha_provisional.ficha_consolidada_id > ficha_clinica.ficha_id
Ref ficha_provisional_ficha_raiz_id_fkey: ficha_provisional.ficha_raiz_id - ficha_clinica.ficha_id
Ref ficha_provisional_id_tenant_fkey: ficha_provisional.id_tenant > institucion_tenant.id_tenant
Ref ficha_provisional_resuelto_por_fkey: ficha_provisional.resuelto_por > usuario.usuario_id
Ref consentimiento_anulado_por_id_fkey: consentimiento.anulado_por_id > usuario.usuario_id
Ref consentimiento_ficha_id_fkey: consentimiento.ficha_id - ficha_clinica.ficha_id
Ref consentimiento_medico_id_fkey: consentimiento.medico_id > usuario.usuario_id
Ref auditoria_evento_usuario_id_fkey: auditoria_evento.usuario_id > usuario.usuario_id
Ref fk_auditoria_tipo_evento: auditoria_evento.tipo_evento > tipo_evento_catalogo.codigo
Ref ficha_cambio_ficha_id_fkey: ficha_cambio.ficha_id > ficha_clinica.ficha_id
Ref ficha_cambio_usuario_id_fkey: ficha_cambio.usuario_id > usuario.usuario_id
Ref cie10_run_rag_version_fkey: cie10_run.rag_version > cie10_rag_version.rag_version
Ref cie10_sugerencia_rag_version_fkey: cie10_sugerencia.rag_version > cie10_rag_version.rag_version

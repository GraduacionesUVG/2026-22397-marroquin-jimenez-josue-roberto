Ref cie10_decision_codigo_traductor_fkey: cie10_decision.codigo_traductor - cie10_sugerencia.codigo_traductor
Ref cie10_revision_item_codigo_traductor_fkey: cie10_revision_item.codigo_traductor > cie10_sugerencia.codigo_traductor
Ref cie10_revision_item_run_id_fkey: cie10_revision_item.run_id > cie10_run.run_id
Ref cie10_lote_confirmacion_clausula_version_fkey: cie10_lote_confirmacion.clausula_version > cie10_clausula.version
Ref cie10_lote_confirmacion_run_id_fkey: cie10_lote_confirmacion.run_id - cie10_run.run_id
Ref cie10_rag_catalogo_rag_version_fkey: cie10_rag_catalogo.rag_version > cie10_rag_version.rag_version [delete: cascade]
Ref parte_del_cuerpo_region_id_fkey: parte_del_cuerpo.region_id > region_anatomica.region_id

TableGroup organizacion {
  usuario
  institucion_tenant
}

TableGroup integracion {
  sistema_externo
  sistema_externo_permiso
  sesion_integracion
  nonce_usado
}

TableGroup paciente {
  paciente
  paciente_nombre_token
}

TableGroup clinico {
  ficha_clinica
  datos_adicionales_ficha
  familiar_afectado
  signo_alerta_ficha
  examen_ficha
  observacion_ficha
  resultado_ia
  ficha_provisional
}

TableGroup consentimiento {
  consentimiento
}

TableGroup auditoria {
  auditoria_evento
  tipo_evento_catalogo
  ficha_cambio
}

TableGroup cie10 {
  cie10_run
  cie10_sugerencia
  cie10_decision
  cie10_decision_historial
  cie10_catalogo
  cie10_revision_item
  cie10_lote_confirmacion
  cie10_clausula
  cie10_rag_version
  cie10_rag_catalogo
}

TableGroup catalogos {
  signo_catalogo
  examen_catalogo
  region_anatomica
  parte_del_cuerpo
  lateralidad
  referido_de
  asistencia_parto
  familiar_catalogo
  sexo_catalogo
}

TableGroup control {
  schema_migrations
}
